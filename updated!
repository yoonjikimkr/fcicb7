        "def _rev(df, user_col, time_col, amount_col, stream):\n",
        "    out = df[[user_col, time_col, amount_col]].copy()\n",
        "    out.columns = ['user_id', 'event_time', 'revenue_usd']\n",
        "    out['stream'] = stream\n",
        "    return out\n",
        "\n",
        "rev_transfer = _rev(transactions,  'user_id', 'txn_time',     'fee_usd',        'Transfer Fee')\n",
        "rev_fx       = _rev(fx_exchanges,  'user_id', 'fx_time',      'spread_usd',     'FX Spread')\n",
        "rev_trade    = _rev(trades,        'user_id', 'trade_time',   'commission_usd', 'Trade Commission')\n",
        "rev_sub      = _rev(subscriptions, 'user_id', 'billing_date', 'mrr_usd',        'Subscription')\n",
        "\n",
        "revenue = pd.concat([rev_transfer, rev_fx, rev_trade, rev_sub], ignore_index=True)\n",
        "revenue = revenue[revenue['revenue_usd'] > 0].copy()\n",
        "revenue['event_time']  = pd.to_datetime(revenue['event_time'])\n",
        "revenue['event_month'] = revenue['event_time'].dt.to_period('M').dt.to_timestamp()\n",
        "\n",
        "print(f\"총 매출 이벤트: {len(revenue):,}\")\n",
        "print(f\"총 매출 USD:   ${revenue['revenue_usd'].sum():,.2f}\")\n",
        "revenue.head()"
