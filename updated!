      "source": [
        "bubble2 = bubble2.sort_values('expected_rev', ascending=False)\n",
        "\n",
        "min_px, max_px = 28, 72\n",
        "sizes2 = bubble2['total_expected']\n",
        "norm_sizes2 = min_px + (sizes2 - sizes2.min()) / (sizes2.max() - sizes2.min()) * (max_px - min_px)\n",
        "\n",
        "channel_colors = {\n",
        "    'referral': '#1D9E75', 'organic': '#378ADD', 'google': '#7F77DD',\n",
        "    'youtube': '#D85A30',  'instagram': '#BA7517', 'facebook': '#888780'\n",
        "}\n",
        "\n",
        "fig = go.Figure()\n",
        "\n",
        "for ch, row in bubble2.iterrows():\n",
        "    fig.add_trace(go.Scatter(\n",
        "        x=[row['started']],\n",
        "        y=[row['expected_rev']],\n",
        "        mode='markers+text',\n",
        "        marker=dict(\n",
        "            size=norm_sizes2[ch],\n",
        "            color=channel_colors.get(ch, '#888'),\n",
        "            opacity=0.82,\n",
        "            line=dict(width=1.5, color='white')\n",
        "        ),\n",
        "        text=[f\"<b>{ch}</b>\"],\n",
        "        textposition='top center',\n",
        "        name=ch,\n",
        "        hovertemplate=(\n",
        "            f\"<b>{ch}</b><br>\"\n",
        "            f\"Acquired Users: {int(row['started']):,}<br>\"\n",
        "            f\"Conv Rate: {row['conv_rate']*100:.1f}%<br>\"\n",
        "            f\"Avg Rev (active): ${row['total_rev']:,.2f}<br>\"\n",
        "            f\"<b>Expected Rev/User: ${row['expected_rev']:,.2f}</b><br>\"\n",
        "            f\"Total Expected: ${row['total_expected']:,.0f}\"\n",
        "            f\"<extra></extra>\"\n",
        "        )\n",
        "    ))\n",
        "\n",
        "avg_exp2 = bubble2['expected_rev'].mean()\n",
        "avg_vol2 = bubble2['started'].mean()\n",
        "\n",
        "fig.add_hline(y=avg_exp2, line_dash='dot', line_color='#ccc',\n",
        "              annotation_text=f'Avg ${avg_exp2:.2f}/user',\n",
        "              annotation_position='bottom right',\n",
        "              annotation_font=dict(size=10, color='#999'))\n",
        "fig.add_vline(x=avg_vol2, line_dash='dot', line_color='#ccc',\n",
        "              annotation_text=f'Avg {int(avg_vol2):,} users',\n",
        "              annotation_position='top left',\n",
        "              annotation_font=dict(size=10, color='#999'))\n",
        "\n",
        "for x, y, txt in [\n",
        "    (400,  5.6, \"High yield · Low volume\"),\n",
        "    (6200, 5.6, \"High yield · High volume\"),\n",
        "    (400,  2.8, \"Low yield · Low volume\"),\n",
        "    (6200, 2.8, \"Low yield · High volume\"),\n",
        "]:\n",
        "    fig.add_annotation(x=x, y=y, text=txt, showarrow=False,\n",
        "                       font=dict(size=10, color='#bbbbbb'))\n",
        "\n",
        "fig.update_layout(\n",
        "    title=dict(\n",
        "        text='Channel Quality Matrix: Volume vs Revenue Yield<br>'\n",
        "             '<sup>Bubble size = total expected revenue | '\n",
        "             'Revenue = fees + spread + subscription + commission</sup>',\n",
        "        x=0.5, font=dict(size=15)\n",
        "    ),\n",
        "    xaxis=dict(title='Acquired Users (Sign Up Started)',\n",
        "               range=[0, 8500], gridcolor='#f0f0f0', zeroline=False),\n",
        "    yaxis=dict(title='Expected Revenue per Acquired User (USD)',\n",
        "               range=[2.5, 6.5], gridcolor='#f0f0f0', zeroline=False),\n",
        "    width=780, height=520,\n",
        "    plot_bgcolor='white', paper_bgcolor='white',\n",
        "    showlegend=False,\n",
        "    font=dict(size=12, color='#333'),\n",
        "    margin=dict(l=65, r=65, t=90, b=65)\n",
        ")\n",
        "fig.show()"
      ],
