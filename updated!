        "# ── 올바른 수익 컬럼으로 재계산 ────────────────────────────────────\n",
        "# Transfer: fee_usd (수수료), FX: spread_usd, Sub: mrr_usd, Trade: commission_usd\n",
        "\n",
        "txn_rev  = transactions.groupby('user_id')['fee_usd'].sum().rename('transfer_rev')\n",
        "fx_rev   = fx_exchanges.groupby('user_id')['spread_usd'].sum().rename('fx_rev')\n",
        "sub_rev  = subscriptions.groupby('user_id')['mrr_usd'].sum().rename('sub_rev')\n",
        "trd_rev  = trades.groupby('user_id')['commission_usd'].sum().rename('trade_rev')\n",
        "\n",
        "user_rev2 = (users[['user_id','utm_source']]\n",
        "             .join(txn_rev,  on='user_id')\n",
        "             .join(fx_rev,   on='user_id')\n",
        "             .join(sub_rev,  on='user_id')\n",
        "             .join(trd_rev,  on='user_id')\n",
        "             .fillna(0))\n",
        "\n",
        "user_rev2['total_rev'] = user_rev2[['transfer_rev','fx_rev','sub_rev','trade_rev']].sum(axis=1)\n",
        "user_rev2['is_active'] = user_rev2['total_rev'] > 0\n",
        "\n",
        "print(\"수익 컬럼별 총합 확인:\")\n",
        "print(f\"  Transfer fee : ${user_rev2['transfer_rev'].sum():>10,.2f}\")\n",
        "print(f\"  FX spread    : ${user_rev2['fx_rev'].sum():>10,.2f}\")\n",
        "print(f\"  Subscription : ${user_rev2['sub_rev'].sum():>10,.2f}\")\n",
        "print(f\"  Trade comm   : ${user_rev2['trade_rev'].sum():>10,.2f}\")\n",
        "print(f\"  Total        : ${user_rev2['total_rev'].sum():>10,.2f}\")\n",
        "\n",
        "# ── 버블차트용 채널별 재집계 ────────────────────────────────────────\n",
        "started2 = (events[events['event_name'] == 'Sign Up Started']\n",
        "            .merge(users[['user_id','utm_source']], on='user_id')\n",
        "            .groupby('utm_source')['user_id'].nunique()\n",
        "            .rename('started'))\n",
        "\n",
        "completed2 = (events[events['event_name'] == 'Sign up Completed']\n",
        "              .merge(users[['user_id','utm_source']], on='user_id')\n",
        "              .groupby('utm_source')['user_id'].nunique()\n",
        "              .rename('completed'))\n",
        "\n",
        "funnel2 = pd.concat([started2, completed2], axis=1).fillna(0)\n",
        "funnel2['conv_rate'] = funnel2['completed'] / funnel2['started']\n",
        "\n",
        "avg_rev2 = (user_rev2[user_rev2['is_active']]\n",
        "            .groupby('utm_source')[['transfer_rev','fx_rev','sub_rev','trade_rev','total_rev']]\n",
        "            .mean().round(3))\n",
        "\n",
        "bubble2 = funnel2.join(avg_rev2)\n",
        "bubble2['expected_rev'] = (bubble2['total_rev'] * bubble2['conv_rate']).round(2)\n",
        "bubble2['total_expected'] = (bubble2['expected_rev'] * bubble2['started']).round(0)\n",
        "bubble2 = bubble2.sort_values('expected_rev', ascending=False)\n",
        "\n",
        "print(\"\\n채널별 올바른 수익 요약:\")\n",
        "print(bubble2[['started','conv_rate','transfer_rev','fx_rev','sub_rev','trade_rev','total_rev','expected_rev']].round(2))\n",
        "\n",
        "# ── Product Mix Heatmap (올바른 수익 기준) ──────────────────────────\n",
        "product_df2 = user_rev2.copy()\n",
        "product_df2['use_transfer'] = product_df2['transfer_rev'] > 0\n",
        "product_df2['use_fx']       = product_df2['fx_rev'] > 0\n",
        "product_df2['use_sub']      = product_df2['sub_rev'] > 0\n",
        "product_df2['use_trade']    = product_df2['trade_rev'] > 0\n",
        "\n",
        "mix2 = product_df2.groupby('utm_source').agg(\n",
        "    pct_transfer = ('use_transfer', 'mean'),\n",
        "    pct_fx       = ('use_fx',       'mean'),\n",
        "    pct_sub      = ('use_sub',      'mean'),\n",
        "    pct_trade    = ('use_trade',    'mean'),\n",
        ").round(3) * 100\n",
        "\n",
        "mix2 = mix2.sort_values('pct_transfer', ascending=False)\n",
        "print(\"\\n채널별 상품 채택률 (올바른 기준):\")\n",
        "print(mix2)\n",
        "\n",
        "# ── Heatmap 차트 ────────────────────────────────────────────────────\n",
        "import plotly.graph_objects as go\n",
        "\n",
        "hm = mix2.copy()\n",
        "hm.columns = ['Transfer Fee', 'FX Spread', 'Subscription', 'Trade']\n",
        "hm = hm.sort_values('Transfer Fee', ascending=True)\n",
        "\n",
        "fig = go.Figure(go.Heatmap(\n",
        "    z=hm.values,\n",
        "    x=hm.columns.tolist(),\n",
        "    y=hm.index.tolist(),\n",
        "    colorscale=[[0.0,'#F1EFE8'],[0.5,'#5DCAA5'],[1.0,'#085041']],\n",
        "    text=[[f'{v:.1f}%' for v in row] for row in hm.values],\n",
        "    texttemplate='%{text}',\n",
        "    textfont=dict(size=13, color='#085041'),\n",
        "    showscale=True,\n",
        "    colorbar=dict(title='Adoption %', thickness=14)\n",
        "))\n",
        "\n",
        "fig.update_layout(\n",
        "    title=dict(\n",
        "        text='Product Adoption Rate by Acquisition Channel<br>'\n",
        "             '<sup>% of all users in each channel who generated revenue from each product</sup>',\n",
        "        x=0.5, font=dict(size=14)\n",
        "    ),\n",
        "    xaxis=dict(title='Revenue Stream', side='top'),\n",
        "    yaxis=dict(title='Acquisition Channel'),\n",
        "    width=580, height=380,\n",
        "    plot_bgcolor='white', paper_bgcolor='white',\n",
        "    font=dict(size=12),\n",
        "    margin=dict(l=90, r=60, t=120, b=40)\n",
        ")\n",
        "fig.show()"
