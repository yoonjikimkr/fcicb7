      "source": [
        "import plotly.graph_objects as go\n",
        "from plotly.subplots import make_subplots\n",
        "\n",
        "# ── 채널별 상품 사용 유저 수 & 평균 수익 ──────────────────────────\n",
        "# 각 상품 사용 여부 플래그\n",
        "txn_users = transactions.groupby('user_id')['usd_amount'].sum().rename('transfer_usd')\n",
        "fx_users  = fx_exchanges.groupby('user_id')['spread_usd'].sum().rename('fx_usd')\n",
        "sub_users = subscriptions.groupby('user_id')['mrr_usd'].sum().rename('sub_usd')\n",
        "\n",
        "product_df = (users[['user_id','utm_source']]\n",
        "              .join(txn_users, on='user_id')\n",
        "              .join(fx_users,  on='user_id')\n",
        "              .join(sub_users, on='user_id')\n",
        "              .fillna(0))\n",
        "\n",
        "product_df['use_transfer'] = product_df['transfer_usd'] > 0\n",
        "product_df['use_fx']       = product_df['fx_usd'] > 0\n",
        "product_df['use_sub']      = product_df['sub_usd'] > 0\n",
        "product_df['n_products']   = (product_df[['use_transfer','use_fx','use_sub']]\n",
        "                               .sum(axis=1))\n",
        "\n",
        "# 채널별 집계\n",
        "mix = product_df.groupby('utm_source').agg(\n",
        "    total_users   = ('user_id',       'count'),\n",
        "    pct_transfer  = ('use_transfer',  'mean'),\n",
        "    pct_fx        = ('use_fx',        'mean'),\n",
        "    pct_sub       = ('use_sub',       'mean'),\n",
        "    avg_transfer  = ('transfer_usd',  'mean'),\n",
        "    avg_fx        = ('fx_usd',        'mean'),\n",
        "    avg_sub       = ('sub_usd',       'mean'),\n",
        "    avg_n_products= ('n_products',    'mean'),\n",
        ").round(3)\n",
        "\n",
        "mix[['pct_transfer','pct_fx','pct_sub']] *= 100\n",
        "mix = mix.sort_values('avg_n_products', ascending=False)\n",
        "print(mix)\n",
        "\n",
        "# ── 차트: 2행 구성 ─────────────────────────────────────────────────\n",
        "sources = mix.index.tolist()\n",
        "colors  = {'Transfer': '#1D9E75', 'FX Exchange': '#378ADD', 'Subscription': '#7F77DD'}\n",
        "\n",
        "fig = make_subplots(\n",
        "    rows=2, cols=1,\n",
        "    subplot_titles=(\n",
        "        'Product Adoption Rate by Channel (% of all users)',\n",
        "        'Avg Revenue per User by Product (USD)'\n",
        "    ),\n",
        "    vertical_spacing=0.18\n",
        ")\n",
        "\n",
        "# 상단: 상품 채택률 grouped bar\n",
        "for col, label, color in [\n",
        "    ('pct_transfer', 'Transfer',     '#1D9E75'),\n",
        "    ('pct_fx',       'FX Exchange',  '#378ADD'),\n",
        "    ('pct_sub',      'Subscription', '#7F77DD'),\n",
        "]:\n",
        "    fig.add_trace(go.Bar(\n",
        "        x=sources, y=mix[col],\n",
        "        name=label, marker_color=color,\n",
        "        text=mix[col].apply(lambda v: f'{v:.1f}%'),\n",
        "        textposition='outside',\n",
        "        legendgroup=label\n",
        "    ), row=1, col=1)\n",
        "\n",
        "# 하단: 평균 수익 stacked bar\n",
        "for col, label, color in [\n",
        "    ('avg_transfer', 'Transfer',     '#1D9E75'),\n",
        "    ('avg_fx',       'FX Exchange',  '#378ADD'),\n",
        "    ('avg_sub',      'Subscription', '#7F77DD'),\n",
        "]:\n",
        "    fig.add_trace(go.Bar(\n",
        "        x=sources, y=mix[col],\n",
        "        name=label, marker_color=color,\n",
        "        legendgroup=label,\n",
        "        showlegend=False\n",
        "    ), row=2, col=1)\n",
        "\n",
        "fig.update_layout(\n",
        "    barmode='group',\n",
        "    title=dict(\n",
