        "# 코호트 정보에 채널 붙이기\n",
        "rev2 = rev.merge(users[['user_id','utm_source']], on='user_id', how='left')\n",
        "\n",
        "# 채널 × tenure_month ARPU\n",
        "ch_rev = (rev2.groupby(['utm_source','tenure_month'])['revenue_usd'].sum()\n",
        "              .unstack(fill_value=0))\n",
        "ch_size = users.groupby('utm_source').size()\n",
        "ch_arpu = ch_rev.div(ch_size, axis=0)\n",
        "\n",
        "# 누적 LTV\n",
        "ch_cum = ch_arpu.cumsum(axis=1)\n",
        "ch_cum.round(2)"
