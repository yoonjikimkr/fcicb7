      "source": [
        "# 1) 매출 이벤트에 가입월을 붙이기\n",
        "rev = revenue.merge(\n",
        "    users[['user_id','signup_date']], on='user_id', how='inner'\n",
        ")\n",
        "rev['cohort_month'] = rev['signup_date'].dt.to_period('M').dt.to_timestamp()\n",
        "rev['tenure_month'] = ((rev['event_time'].dt.to_period('M') -\n",
        "                        rev['signup_date'].dt.to_period('M'))\n",
        "                       .apply(lambda x: x.n))\n",
        "rev = rev[rev['tenure_month'] >= 0]\n",
        "\n",
        "# 2) 각 코호트의 유저 수 (분모)\n",
        "cohort_size = users.groupby(users['signup_date'].dt.to_period('M').dt.to_timestamp()).size()\n",
        "cohort_size.name = 'n_users'\n",
        "\n",
        "# 3) 코호트 × 경과월 매출 합계\n",
        "cohort_rev = (rev.groupby(['cohort_month','tenure_month'])['revenue_usd']\n",
        "                 .sum().unstack(fill_value=0))\n",
        "\n",
        "# 4) 유저 1인당 매출(ARPU by tenure)\n",
        "cohort_arpu = cohort_rev.div(cohort_size, axis=0)\n",
        "cohort_arpu.round(2).head(8)"
      ]
    },
