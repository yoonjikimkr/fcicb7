        "    plot_bgcolor='white',\n",
        "    paper_bgcolor='white',\n",
        "    font=dict(size=12)\n",
        ")\n",
        "fig.update_yaxes(gridcolor='#f0f0f0')\n",
        "\n",
        "fig.show()"
