        "import plotly.graph_objects as go\n",
        "import numpy as np\n",
        "\n",
        "channel_colors = {\n",
        "    'referral': '#1D9E75', 'organic': '#378ADD', 'google': '#7F77DD',\n",
        "    'youtube': '#D85A30',  'instagram': '#BA7517', 'facebook': '#888780'\n",
        "}\n",
        "\n",
        "# 버블 사이즈: 25~70px 사이로 수동 정규화\n",
        "min_px, max_px = 28, 72\n",
        "sizes = bubble_df['total_expected']\n",
        "norm_sizes = min_px + (sizes - sizes.min()) / (sizes.max() - sizes.min()) * (max_px - min_px)\n",
        "\n",
        "fig = go.Figure()\n",
        "\n",
        "for ch, row in bubble_df.iterrows():\n",
        "    fig.add_trace(go.Scatter(\n",
        "        x=[row['volume']],\n",
        "        y=[row['expected_rev']],\n",
        "        mode='markers+text',\n",
        "        marker=dict(\n",
        "            size=norm_sizes[ch],\n",
        "            color=channel_colors.get(ch, '#888'),\n",
        "            opacity=0.82,\n",
        "            line=dict(width=1.5, color='white')\n",
        "        ),\n",
        "        text=[f\"<b>{ch}</b>\"],\n",
        "        textposition='top center',\n",
        "        name=ch,\n",
        "        hovertemplate=(\n",
        "            f\"<b>{ch}</b><br>\"\n",
        "            f\"Acquired Users: {int(row['volume']):,}<br>\"\n",
        "            f\"Conv Rate: {row['conversion_rate']*100:.1f}%<br>\"\n",
        "            f\"Avg Rev (active): ${row['avg_rev_active']:,.0f}<br>\"\n",
        "            f\"<b>Expected Rev/User: ${row['expected_rev']:,.0f}</b><br>\"\n",
        "            f\"Total Expected: ${row['total_expected']:,.0f}\"\n",
        "            f\"<extra></extra>\"\n",
        "        )\n",
        "    ))\n",
        "\n",
        "avg_exp = bubble_df['expected_rev'].mean()\n",
        "avg_vol = bubble_df['volume'].mean()\n",
        "\n",
        "fig.add_hline(y=avg_exp, line_dash='dot', line_color='#ccc',\n",
        "              annotation_text=f'Avg ${avg_exp:.0f}/user',\n",
        "              annotation_position='bottom right',\n",
        "              annotation_font=dict(size=10, color='#999'))\n",
        "\n",
        "fig.add_vline(x=avg_vol, line_dash='dot', line_color='#ccc',\n",
        "              annotation_text=f'Avg {int(avg_vol):,} users',\n",
        "              annotation_position='top left',\n",
        "              annotation_font=dict(size=10, color='#999'))\n",
        "\n",
        "# 사분면 레이블 — color 명시\n",
        "for x, y, txt in [\n",
        "    (400,  480, \"High yield · Low volume\"),\n",
        "    (6200, 480, \"High yield · High volume\"),\n",
        "    (400,  30,  \"Low yield · Low volume\"),\n",
        "    (6200, 30,  \"Low yield · High volume\"),\n",
        "]:\n",
        "    fig.add_annotation(\n",
        "        x=x, y=y, text=txt, showarrow=False, align='center',\n",
        "        font=dict(size=10, color='#bbbbbb')  # 명시적 회색\n",
        "    )\n",
        "\n",
        "fig.update_layout(\n",
        "    title=dict(\n",
        "        text='Channel Quality Matrix: Volume vs Revenue Yield<br>'\n",
        "             '<sup>Bubble size = total expected revenue | dotted lines = average</sup>',\n",
        "        x=0.5, font=dict(size=15, color='#333')\n",
        "    ),\n",
        "    xaxis=dict(\n",
        "        title='Acquired Users (Sign Up Started)',\n",
        "        range=[0, 8500], gridcolor='#f0f0f0', zeroline=False\n",
        "    ),\n",
        "    yaxis=dict(\n",
        "        title='Expected Revenue per Acquired User (USD)',\n",
        "        range=[0, 520], gridcolor='#f0f0f0', zeroline=False\n",
        "    ),\n",
        "    width=780, height=520,\n",
        "    plot_bgcolor='white', paper_bgcolor='white',\n",
        "    showlegend=False,\n",
        "    font=dict(size=12, color='#333'),\n",
        "    margin=dict(l=65, r=65, t=90, b=65)\n",
        ")\n",
        "\n",
        "fig.show()"
