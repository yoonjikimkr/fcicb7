        "import pandas as pd\n",
        "import plotly.graph_objects as go\n",
        "from plotly.subplots import make_subplots\n",
        "\n",
        "# ── 1. 유저별 수익 집계 ─────────────────────────────────────────────\n",
        "txn_rev = (transactions.groupby('user_id')['usd_amount']\n",
        "           .sum().rename('transfer_usd'))\n",
        "\n",
        "fx_rev  = (fx_exchanges.groupby('user_id')['spread_usd']\n",
        "           .sum().rename('fx_usd'))\n",
        "\n",
        "sub_rev = (subscriptions.groupby('user_id')['mrr_usd']\n",
        "           .sum().rename('sub_usd'))\n",
        "\n",
        "user_rev = (users[['user_id','utm_source','kyc_completed']]\n",
        "            .join(txn_rev, on='user_id')\n",
        "            .join(fx_rev,  on='user_id')\n",
        "            .join(sub_rev, on='user_id')\n",
        "            .fillna(0))\n",
        "\n",
        "user_rev['total_usd'] = user_rev[['transfer_usd','fx_usd','sub_usd']].sum(axis=1)\n",
        "user_rev['is_active']  = user_rev['total_usd'] > 0\n",
        "\n",
        "# ── 2. UTM Source별 집계 ────────────────────────────────────────────\n",
        "# 2-A. 퍼널 전환율\n",
        "funnel_events = ['Sign Up Started', 'Personal Details Added',\n",
        "                 'ID Uploaded', 'Sign up Completed']\n",
        "\n",
        "funnel_counts = {}\n",
        "for step in funnel_events:\n",
        "    reached = events[events['event_name'] == step]['user_id'].nunique()\n",
        "    funnel_counts[step] = reached\n",
        "\n",
        "# UTM별 퍼널 (Signup Started 대비 Completed 비율)\n",
        "started   = (events[events['event_name'] == 'Sign Up Started']\n",
        "             .merge(users[['user_id','utm_source']], on='user_id')\n",
        "             .groupby('utm_source')['user_id'].nunique()\n",
        "             .rename('started'))\n",
        "\n",
        "completed = (events[events['event_name'] == 'Sign up Completed']\n",
        "             .merge(users[['user_id','utm_source']], on='user_id')\n",
        "             .groupby('utm_source')['user_id'].nunique()\n",
        "             .rename('completed'))\n",
        "\n",
        "funnel_df = pd.concat([started, completed], axis=1).fillna(0)\n",
        "funnel_df['conversion_rate'] = (funnel_df['completed'] / funnel_df['started'] * 100).round(1)\n",
        "\n",
        "# 2-B. UTM별 평균 수익 (activated user 기준)\n",
        "rev_by_utm = (user_rev[user_rev['is_active']]\n",
        "              .groupby('utm_source')[['transfer_usd','fx_usd','sub_usd','total_usd']]\n",
        "              .mean()\n",
        "              .round(2))\n",
        "\n",
        "# ── 3. 합치기 & 정렬 ───────────────────────────────────────────────\n",
        "summary = funnel_df.join(rev_by_utm).fillna(0)\n",
        "summary = summary.sort_values('total_usd', ascending=False)\n",
        "\n",
        "print(summary[['started','completed','conversion_rate','transfer_usd','fx_usd','sub_usd','total_usd']])\n",
        "\n",
        "# ── 4. 차트 ────────────────────────────────────────────────────────\n",
        "fig = make_subplots(\n",
        "    rows=1, cols=2,\n",
        "    subplot_titles=(\n",
        "        'Onboarding Conversion Rate by Acquisition Channel (%)',\n",
        "        'Avg Revenue per Active User by Channel (USD)'\n",
        "    ),\n",
        "    horizontal_spacing=0.12\n",
        ")\n",
        "\n",
        "sources = summary.index.tolist()\n",
        "colors  = {'transfer_usd': '#1D9E75', 'fx_usd': '#378ADD', 'sub_usd': '#7F77DD'}\n",
        "labels  = {'transfer_usd': 'Transfer', 'fx_usd': 'FX Exchange', 'sub_usd': 'Subscription'}\n",
        "\n",
        "# 왼쪽: 전환율 bar\n",
        "fig.add_trace(\n",
        "    go.Bar(\n",
        "        x=sources,\n",
        "        y=summary['conversion_rate'],\n",
        "        marker_color='#1D9E75',\n",
        "        text=summary['conversion_rate'].apply(lambda x: f'{x}%'),\n",
        "        textposition='outside',\n",
        "        name='Conversion Rate'\n",
        "    ),\n",
        "    row=1, col=1\n",
        ")\n",
        "\n",
        "# 오른쪽: 수익 stacked bar\n",
        "for col, color in colors.items():\n",
        "    fig.add_trace(\n",
        "        go.Bar(\n",
        "            x=sources,\n",
        "            y=summary[col],\n",
        "            name=labels[col],\n",
        "            marker_color=color\n",
        "        ),\n",
        "        row=1, col=2\n",
        "    )\n",
        "\n",
        "fig.update_layout(\n",
        "    barmode='stack',\n",
        "    title=dict(\n",
        "        text='Acquisition Channel Quality Analysis<br>'\n",
        "             '<sup>Which channels bring users who actually convert and spend?</sup>',\n",
        "        x=0.5, font=dict(size=16)\n",
